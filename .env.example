# ============================================================================
# aachat-curation-bot environment
# ============================================================================
# Copy to .env and fill in the secrets. NEVER commit .env.

# aachat API
AACHAT_API_URL=http://localhost:3100
# Path to the long-lived user JWT (kensaku63 or p-take55). See knowledge/token-setup.md.
AACHAT_JWT_PATH=$HOME/.aachat/curation-jwt

# GitHub PAT used by `make refresh-jwt` to mint a new JWT when the old one expires.
# Fine-grained PAT, owner=kensaku63 (or p-take55), minimal scopes (read-only access to public repos).
AACHAT_OPS_GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
